# Ultra RAG — environment variables
# Copy to .env and fill in your values. Never commit .env.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL password for the 'postgres' superuser.
# Windows: native service defaults to port 5434 (config.yaml db.port).
# Docker: typically port 5432 — update config.yaml db.port accordingly.
RAG_DB_PASSWORD=your_postgres_password

# ── Embedding / NIM ──────────────────────────────────────────────────────────
# Required for NVIDIA NIM reranker API fallback and NV-Embed-v2 download.
NVIDIA_API_KEY=nvapi-your-key-here

# ── API keys (multi-tenant auth) ─────────────────────────────────────────────
# Admin key: access to ALL collections and system endpoints.
ULTRA_RAG_API_KEY=your-admin-secret-key

# Per-collection keys (share only with authorised users of that collection).
# Add one line per collection: ULTRA_RAG_KEY_<COLLECTION>=secret
# ULTRA_RAG_KEY_imds=imds-collection-secret
# ULTRA_RAG_KEY_personal=personal-collection-secret

# ── Redis semantic cache ──────────────────────────────────────────────────────
ULTRA_RAG_CACHE=true
REDIS_URL=redis://localhost:6379

# ── MemoryWeb integration (optional) ─────────────────────────────────────────
MEMORYWEB_ENABLED=true
MEMORYWEB_URL=http://localhost:8100

# ── Remote / tunnel config (optional, for multi-machine setups) ──────────────
# ULTRA_RAG_URL=https://api.yourdomain.com
# ULTRA_RAG_SYSTEM_ID=laptop-1
