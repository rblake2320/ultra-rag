# Ultra RAG Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.

# ── Database ──────────────────────────────────────────────────────────────────
RAG_DB_HOST=localhost
RAG_DB_PORT=5433
RAG_DB_NAME=memoryweb
RAG_DB_USER=memoryweb
RAG_DB_PASSWORD=yourpasswordhere

# ── Local model serving ───────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── API Server ────────────────────────────────────────────────────────────────
# Leave ULTRARAG_API_KEY blank for local development. Set it in shared or
# network-exposed deployments and send it as the X-API-Key header.
ULTRARAG_API_KEY=
ULTRARAG_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8300
# Set true when the process should fail startup if DB/schema checks fail.
ULTRARAG_STRICT_STARTUP=false

# ── NVIDIA NIM Reranker (optional) ───────────────────────────────────────────
# Sign up free at https://build.nvidia.com to get an API key.
# Leave blank to skip NIM reranking (system falls back to score-based sorting).
NVIDIA_API_KEY=

# ── Claude / Anthropic API (optional fallback LLM) ───────────────────────────
# Used as a high-quality fallback if the local Ollama model is unavailable.
# Leave blank to use Ollama only.
ANTHROPIC_API_KEY=

# ── OpenAI API (optional) ─────────────────────────────────────────────────────
# Optional: used in RAGAS evaluation if configured.
OPENAI_API_KEY=
